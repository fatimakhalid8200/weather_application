<h1>Weather for ZIP <%= @forecast[:zip] %></h1>
<p>Address: <%= @forecast[:address]%>, <%= @forecast[:country] %></p>
<p>Temperature: <%= @forecast[:temperature] %> °F</p>
<p>High: <%= @forecast[:high] %> °F</p>
<p>Low: <%= @forecast[:low] %> °F</p>
<p>Condition: <%= @forecast[:description] %></p>
<p>Feels Like: <%= @forecast[:feels_like] %> °F</p>
<p>wind speed: <%= @forecast[:wind_speed] %> °F</p>

<p>name: <%= @forecast[:name] %> °F</p>
<% if @forecast[:cached] %>
  <p style="color: green;">Data loaded from cache</p>
<% else %>
  <p style="color: blue;">Fresh data fetched</p>
<% end %>

<%= link_to "Check another", root_path %>
